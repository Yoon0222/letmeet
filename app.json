{
  "expo": {
    "name": "피넛",
    "slug": "pickleball",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pickleball",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/f6baa6d2-506e-487e-a65d-fa041c68e960",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.pinut.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pinut.app",
      "adaptiveIcon": {
        "backgroundColor": "#163C33",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFCFB",
          "image": "./assets/images/splash-peanut.png",
          "imageWidth": 140,
          "android": {
            "image": "./assets/images/splash-peanut.png",
            "imageWidth": 140
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필·모임·대회 사진을 등록할 때, 사진 보관함에서 이미지를 선택하기 위해 사용합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 주변의 피클볼 코트를 지도에서 찾아 보여주기 위해, 앱을 사용하는 동안에만 위치를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "지도에서 내가 바라보는 방향(나침반)과 이동 방향을 표시하기 위해 기기의 동작·방향 센서를 사용합니다.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "@mj-studio/react-native-naver-map",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6baa6d2-506e-487e-a65d-fa041c68e960"
      }
    }
  }
}
